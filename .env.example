# Copia aquest fitxer a .env.local i omple els valors.
# Cap d'aquests valors s'ha de commitejar mai.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Brevo) — canal de notificacions del pilot ---
EMAIL_PROVIDER=brevo
# Remitent verificat al compte de Brevo (ex: reserves@elteudomini.com)
EMAIL_FROM_ADDRESS=
BREVO_API_KEY=

# --- Cron de recordatoris ---
# Token compartit amb Vercel Cron. Genera'l amb: openssl rand -hex 32
CRON_SECRET=

# --- WhatsApp (Twilio) — previst per a V2 ---
# En Trial nomes funciona amb el sandbox i numeros previament registrats.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
